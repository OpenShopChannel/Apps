{
    "information": {
        "name": "VectrexWii",
        "author": "Aruskano",
        "authors": ["cmyksoda"],
        "category": "emulators",
        "supported_platforms": [
            "wii",
            "vwii",
            "wii_mini"
        ],
        "peripherals": [
            "Wii Remote",
            "GameCube Controller",
            "SDHC"
        ],
        "version": "auto"
    },
    "source": {
        "type": "github_release",
        "format": "zip",
        "location": "https://github.com/cmyksoda/vectrexwii"
    },
    "treatments": [
        {
            "treatment": "contents.move",
            "arguments": [
                "vecxwii/",
                "apps/vecxwii/"
            ]
        },
        {
            "treatment": "meta.init"
        },
        {
            "treatment": "meta.set",
            "arguments": [
                "release_date",
                "20110701000000"
            ]
        }
    ]
}
