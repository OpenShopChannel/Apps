{
    "information": {
        "name": "AM2R GX",
        "author": "cmyksoda",
        "category": "games",
        "supported_platforms": [
            "wii",
            "vwii"
        ],
        "peripherals": [
            "Wii Remote",
            "Nunchuk",
            "Classic Controller",
            "GameCube Controller",
            "SDHC"
        ],
        "flags": [
            "ai_assisted"
        ],
        "notices": {
            "ai_statement": "I use Claude Code, and occasionally Codex, in almost everything I make. I take full responsibility for everything I publish, and I work hard to understand how my software works. Before publishing a finished release, I make sure my code is formatted for legibility, is as free of dead code as I can tell, and has only clean, necessary comments. Full statement: https://github.com/cmyksoda/cmyksoda/blob/main/AI_USAGE.md"
        },
        "version": "auto"
    },
    "source": {
        "type": "github_release",
        "format": "zip",
        "repository": "cmyksoda/AM2R-GX",
        "file": "am2r-gx-[0-9]*[0-9].zip"
    },
    "treatments": [
        {
            "treatment": "contents.move",
            "arguments": [
                "am2r-gx-*/apps/am2r/",
                "apps/am2r/"
            ]
        }
    ]
}
