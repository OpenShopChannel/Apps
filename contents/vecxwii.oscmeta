{
    "information": {
        "name": "VectrexWii",
        "author": "Aruskano",
        "authors": ["cmyksoda"],
        "category": "emulators",
        "supported_platforms": [
            "wii",
            "vwii",
            "wii_mini"
        ],
        "peripherals": [
            "Wii Remote",
            "GameCube Controller",
            "SDHC"
        ],
        "version": "auto"
    },
    "source": {
        "type": "github_release",
        "format": "zip",
        "repository": "cmyksoda/vectrexwii",
        "file": "vecxwii.zip"
    },
    "treatments": [
        {
            "treatment": "contents.move",
            "arguments": [
                "boot.dol",
                "apps/vecxwii/boot.dol"
            ]
        },
        {
            "treatment": "contents.move",
            "arguments": [
                "icon.png",
                "apps/vecxwii/icon.png"
            ]
        },
        {
            "treatment": "contents.move",
            "arguments": [
                "meta.xml",
                "apps/vecxwii/meta.xml"
            ]
        },
        {
            "treatment": "meta.init"
        },
        {
            "treatment": "meta.set",
            "arguments": [
                "release_date",
                "20110701000000"
            ]
        }
    ]
}
